# =============================================================
# hAI.9Router - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================

# --- Server Configuration ---
# Port for the 9Router dashboard (default: 20128)
ROUTER_PORT=20128

# Timezone (adjust to your location)
TZ=Europe/Berlin

# --- AI Backend URLs ---
# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Ollama Backend (if running locally)
OLLAMA_HOST=http://ollama:11434

# LocalAI Backend (if running locally)
LOCAL_AI_HOST=http://localai:8080

# --- Routing Configuration ---
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# Dashboard title (optional customization)
DASHBOARD_TITLE=hAI.9Router - LAN Dashboard

# --- Optional: External Proxy Integration ---
# Uncomment if using Traefik or NGINX Proxy Manager
# TRAEFIK_DOMAIN=9router.local
# PROXY_NETWORK=proxy_net

# --- Security ---
# Enable authentication (future feature)
# AUTH_ENABLED=false
# AUTH_USER=admin
# AUTH_PASSWORD=changeme

# =============================================================
# Quick Start:
# 1. Copy:  cp .env.example .env
# 2. Edit:  nano .env
# 3. Add your OPENAI_API_KEY
# 4. Start: docker compose up -d
# =============================================================
