# =============================================================
# hAI.9Router - Environment Configuration
# Official 9Router Docker Stack
# =============================================================

# --- Port Configuration ---
# External port for 9Router Dashboard
ROUTER_PORT=20128

# Internal port (don't change unless you know what you're doing)
PORT=20128
HOSTNAME=0.0.0.0

# --- Authentication ---
# Initial password for first login (CHANGE THIS!)
INITIAL_PASSWORD=123456

# JWT secret for session tokens (generate a long random string)
# Example: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-key-here

# --- Data Directory ---
# Path inside container where data is stored
DATA_DIR=/app/data

# --- Timezone ---
# Set your local timezone
TZ=Europe/Berlin

# =============================================================
# WICHTIG:
# 1. Kopiere diese Datei: cp .env.example .env
# 2. Bearbeite .env mit deinen Werten: nano .env
# 3. Ändere INITIAL_PASSWORD und JWT_SECRET!
# 4. Starte den Stack: docker compose up -d
# 
# Nach dem Start:
# - Dashboard: http://<deine-IP>:20128
# - Login mit INITIAL_PASSWORD
# - API-Keys für 60+ Provider im Dashboard konfigurieren
# =============================================================

# --- Optional: Erweiterte Einstellungen ---
# Uncomment nur wenn du weißt was du tust

# Node Environment
# NODE_ENV=production

# Telemetry (disable for privacy)
# NEXT_TELEMETRY_DISABLED=1

# Custom data directory on host
# Falls du einen anderen Pfad verwenden willst
# Dann docker-compose.yml entsprechend anpassen:
# volumes:
#   - /mein/custom/pfad:/app/data
